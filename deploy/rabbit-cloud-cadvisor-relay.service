[Unit]
Description=Private Greenleaf cloud cAdvisor relay to deployment monitoring
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStartPre=/usr/bin/curl -fsS --max-time 5 -o /dev/null http://127.0.0.1:18082/metrics
ExecStart=/usr/bin/ssh -NT -F /dev/null -i /etc/rabbit-cloud-cadvisor/id_ed25519 -o UserKnownHostsFile=/etc/rabbit-cloud-cadvisor/known_hosts -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 172.23.0.1:19118:127.0.0.1:18082 monitoring-cloud@169.58.132.8
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/rabbit-cloud-cadvisor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
