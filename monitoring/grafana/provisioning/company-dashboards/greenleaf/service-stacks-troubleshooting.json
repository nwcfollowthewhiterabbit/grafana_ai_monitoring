    "list": [
      {
        "name": "company",
        "label": "Company",
        "type": "constant",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "greenleaf",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "greenleaf",
          "value": "greenleaf"
        },
        "options": [
          {
            "selected": true,
            "text": "greenleaf",
            "value": "greenleaf"
          }
        ],
        "hide": 2
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(docker_stack_container_running{company=~\"$company\"}, alias)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "stack",
