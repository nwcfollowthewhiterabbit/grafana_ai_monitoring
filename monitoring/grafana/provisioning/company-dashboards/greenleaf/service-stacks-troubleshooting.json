        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(docker_stack_container_running{company=~\"$company\",alias=~\"$node\",stack!~\"monitoring.*|node-exporter\"}, stack)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
