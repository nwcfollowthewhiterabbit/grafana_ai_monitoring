GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value
GRAFANA_SECRET_KEY=replace-with-a-long-random-value

# `shadow` persists incident transitions but never contacts Telegram. Change to
# `live` only after the shadow audit and a delivery test have passed.
INCIDENT_GATEWAY_MODE=shadow
INCIDENT_GATEWAY_BUILD_CONTEXT=../services/incident-gateway
MONITORING_DATA_ROOT=/var/lib/monitoring

# Leave these blank in shadow mode. For live mode, point them at files mounted
# from monitoring/secrets; never commit the file contents.
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID_FILE=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_MESSAGE_THREAD_ID_FILE=
