[Unit]
Description=Queued scheduled public site checker
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/monitoring/scripts/scheduled-public-site-checker.py --catalog /root/monitoring/service-catalog.yml --output /var/lib/node-exporter-textfile/scheduled-public-sites.prom --lock /run/scheduled-public-site-checker/lock --timeout 12 --max-workers 16 --queue-buckets 180 --retry-count 3 --retry-interval 300 --failure-threshold 3
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

